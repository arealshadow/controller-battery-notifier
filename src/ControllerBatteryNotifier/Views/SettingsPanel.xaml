<UserControl x:Class="ControllerBatteryNotifier.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <DataTemplate x:Key="DeviceRowTemplate">
            <Grid Margin="6,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="&#9733;" FontSize="15" Foreground="#F9A825"
                           VerticalAlignment="Center" Margin="0,0,8,0"
                           Visibility="{Binding IsPrimary, Converter={StaticResource BoolToVis}}"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="0">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="{Binding SourceText}" FontSize="11"
                               Foreground="{StaticResource TextMuted}" Margin="0,1,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                    <ProgressBar Width="70" Height="8" Minimum="0" Maximum="100"
                                 Value="{Binding LevelPercent, Mode=OneWay}"
                                 Foreground="{StaticResource AccentBackground}"
                                 Background="{StaticResource GlassFill}"
                                 BorderThickness="0" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding LevelText}" FontWeight="Bold" VerticalAlignment="Center"
                               Foreground="{Binding LevelBrush}"/>
                </StackPanel>

                <Button Grid.Column="3" Content="Primary" Style="{StaticResource PillButton}" FontSize="12"
                        Click="MakePrimary_Click" Tag="{Binding}"
                        ToolTip="This device is shown as the battery icon in the system tray"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="#14FFFFFF" Padding="14,8"
                BorderBrush="#22FFFFFF" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText" Text="Waiting for first device scan…"
                       TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}"/>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="14">

                <TextBlock Text="Controller Battery Notifier" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="Keeps an eye on your controller battery and warns you before it dies mid-game."
                           Foreground="{StaticResource TextSecondary}" Margin="0,2,0,14" TextWrapping="Wrap"/>

                <TextBlock Text="LOW BATTERY NOTIFICATIONS" FontWeight="SemiBold" FontSize="12"
                           Foreground="{StaticResource SectionHeading}" Margin="0,0,0,8"/>
                <CheckBox x:Name="NotifyCheckBox" Content="Notify me when the battery is low"
                          Style="{StaticResource GlassCheckBox}"
                          Margin="0,0,0,10"
                          Checked="NotifyChanged" Unchecked="NotifyChanged"/>
                <DockPanel Margin="0,0,0,4">
                    <TextBlock x:Name="ThresholdLabel" DockPanel.Dock="Right" VerticalAlignment="Center"
                               Text="Threshold: 20%" Foreground="{StaticResource TextSecondary}"/>
                    <Slider x:Name="ThresholdSlider" Minimum="1" Maximum="99" TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            ValueChanged="ThresholdChanged"/>
                </DockPanel>
                <TextBlock Text="You are notified when the level drops to (or below) the threshold.&#10;It repeats only after the battery recovers above it again."
                           Foreground="{StaticResource TextMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,14"/>

                <TextBlock Text="SYSTEM TRAY" FontWeight="SemiBold" FontSize="12"
                           Foreground="{StaticResource SectionHeading}" Margin="0,0,0,8"/>
                <CheckBox x:Name="ShowPercentCheckBox"
                          Content="Show the battery percentage inside the tray icon"
                          Style="{StaticResource GlassCheckBox}"
                          Margin="0,0,0,8"
                          Checked="TrayPrefChanged" Unchecked="TrayPrefChanged"/>
                <CheckBox x:Name="StartWithWindowsCheckBox"
                          Content="Start Controller Battery Notifier when I sign in to Windows"
                          Style="{StaticResource GlassCheckBox}"
                          Margin="0,0,0,14"
                          Checked="StartWithWindowsChanged" Unchecked="StartWithWindowsChanged"/>

                <TextBlock Text="DEVICE REFRESH" FontWeight="SemiBold" FontSize="12"
                           Foreground="{StaticResource SectionHeading}" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <TextBlock Text="Check batteries every" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{StaticResource TextPrimary}"/>
                    <ComboBox x:Name="PollIntervalCombo" VerticalAlignment="Center" Width="140"
                              Style="{StaticResource GlassComboBox}"
                              SelectionChanged="PollIntervalChanged">
                        <ComboBoxItem Content="15 seconds" Tag="15"/>
                        <ComboBoxItem Content="30 seconds" Tag="30"/>
                        <ComboBoxItem Content="1 minute" Tag="60"/>
                        <ComboBoxItem Content="2 minutes" Tag="120"/>
                        <ComboBoxItem Content="5 minutes" Tag="300"/>
                        <ComboBoxItem Content="10 minutes" Tag="600"/>
                        <ComboBoxItem Content="30 minutes" Tag="1800"/>
                        <ComboBoxItem Content="1 hour" Tag="3600"/>
                    </ComboBox>
                </StackPanel>

                <TextBlock Text="CONNECTED DEVICES" FontWeight="SemiBold" FontSize="12"
                           Foreground="{StaticResource SectionHeading}" Margin="0,0,0,8"/>
                <ListBox x:Name="DeviceList" MaxHeight="220"
                         BorderBrush="#22FFFFFF" Background="Transparent"
                         ItemTemplate="{StaticResource DeviceRowTemplate}"
                         HorizontalContentAlignment="Stretch"/>
                <TextBlock x:Name="DeviceHint" Foreground="{StaticResource TextMuted}" FontSize="11"
                           TextWrapping="Wrap" Margin="0,6,0,14"/>

                <WrapPanel>
                    <Button x:Name="RefreshButton" Content="Refresh now" Style="{StaticResource PillButton}"
                            Margin="0,0,8,0" Click="Refresh_Click"/>
                    <Button Content="Send test notification" Style="{StaticResource PillButton}"
                            Click="TestNotification_Click"/>
                </WrapPanel>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>