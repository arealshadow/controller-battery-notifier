<Window x:Class="ControllerBatteryNotifier.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ControllerBatteryNotifier"
        Title="Controller Battery Notifier"
        Width="320" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" Focusable="True"
        KeyDown="OnKeyDown">

    <!-- Drop shadow + dark blue glass card -->
    <Border Margin="14" CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.55"/>
        </Border.Effect>
        <Border CornerRadius="16" Background="{StaticResource GlassBackground}"
                BorderBrush="#42FFFFFF" BorderThickness="1">
            <StackPanel Margin="18,16">

                <!-- Header: title + Refresh -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Controller Battery Notifier" FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="SubtitleText" Text="Live battery status" FontSize="11"
                                   Foreground="{StaticResource TextSecondary}" Margin="0,1,0,0"/>
                    </StackPanel>
                    <Button x:Name="RefreshButton" Grid.Column="1" Content="Refresh"
                            Style="{StaticResource PillButton}" VerticalAlignment="Center"
                            FontSize="11" Padding="8,3" Margin="8,0,0,0"
                            Click="Refresh_Click"/>
                </Grid>

                <!-- Connected devices -->
                <TextBlock Text="CONNECTED DEVICES" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource SectionHeading}" Margin="2,0,0,6"/>
                <ItemsControl x:Name="DeviceList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimary}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Source}" FontSize="10"
                                               Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>
                                <Border Grid.Column="1" CornerRadius="9" Padding="10,3"
                                        Background="{StaticResource GlassFill}"
                                        BorderBrush="{StaticResource GlassStroke}" BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Level, Converter={x:Static local:FlyoutWindow.PercentText}}"
                                               Foreground="{Binding Level, Converter={x:Static local:FlyoutWindow.LevelBrush}}"
                                               FontWeight="Bold"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="EmptyText" Text="No controller connected yet."
                           Foreground="{StaticResource TextSecondary}" Margin="2,2,0,0"/>
                <TextBlock x:Name="EmptyHint" FontSize="11" TextWrapping="Wrap"
                           Foreground="{StaticResource TextMuted}" Margin="2,4,0,0"
                           Text="Pair it in Windows Bluetooth settings, wake it with a button press, then press Refresh."/>

                <Border Height="1" Background="#22FFFFFF" Margin="0,14"/>

                <!-- Full settings page -->
                <Button Content="Settings" Style="{StaticResource AccentButton}" Click="Settings_Click"/>

            </StackPanel>
        </Border>
    </Border>
</Window>